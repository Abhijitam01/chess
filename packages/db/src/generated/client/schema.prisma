generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id           String       @id @default(uuid())
  username     String       @unique
  rating       Int          @default(1000)
  totalGames   Int          @default(0) @map("total_games")
  wins         Int          @default(0)
  losses       Int          @default(0)
  draws        Int          @default(0)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  credentials  Credentials?
  gamesAsWhite Game[]       @relation("WhitePlayer")
  gamesAsBlack Game[]       @relation("BlackPlayer")

  @@index([username])
  @@map("profiles")
}

model Credentials {
  profileId    String  @id @map("profile_id")
  passwordHash String  @map("password_hash")
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model Game {
  id                 String     @id @default(uuid())
  whitePlayerId      String?    @map("white_player_id")
  blackPlayerId      String?    @map("black_player_id")
  winner             String?
  resultReason       String?    @map("result_reason")
  pgn                String?
  initialWhiteRating Int        @map("initial_white_rating")
  initialBlackRating Int        @map("initial_black_rating")
  whiteRatingChange  Int?       @map("white_rating_change")
  blackRatingChange  Int?       @map("black_rating_change")
  startedAt          DateTime?  @default(now()) @map("started_at")
  finishedAt         DateTime?  @map("finished_at")
  createdAt          DateTime?  @default(now()) @map("created_at")
  moves              GameMove[]
  whitePlayer        Profile?   @relation("WhitePlayer", fields: [whitePlayerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  blackPlayer        Profile?   @relation("BlackPlayer", fields: [blackPlayerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)])
  @@index([blackPlayerId], map: "games_black_player_idx")
  @@index([whitePlayerId], map: "games_white_player_idx")
  @@map("games")
}

model GameMove {
  id            BigInt    @id @default(autoincrement())
  gameId        String    @map("game_id")
  moveNumber    Int       @map("move_number")
  moveSan       String    @map("move_san")
  moveUci       String    @map("move_uci")
  fen           String
  timeLeftWhite Int?      @map("time_left_white")
  timeLeftBlack Int?      @map("time_left_black")
  createdAt     DateTime? @default(now()) @map("created_at")
  game          Game      @relation(fields: [gameId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([gameId])
  @@map("game_moves")
}
